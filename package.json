{
  "name": "constructviz-ai",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"tsx server/index.ts\" \"vite\"",
    "server": "tsx server/index.ts",
    "build:frontend": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --outfile=dist-server/app.cjs --format=cjs --define:process.env.GITHUB_SHA=\\\"${GITHUB_SHA:-unknown}\\\"",
    "build": "npm run build:frontend && npm run build:server",
    "start": "node dist-server/app.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@google/genai": "^1.30.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.15.6",
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.0",
    "mysql2": "^3.22.3",
    "nodemailer": "^8.0.7",
    "openai": "^6.44.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.16.0",
    "sharp": "^0.34.5",
    "stripe": "^22.1.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@typesafe-ai/sdk": "^0.6.0",
    "autoprefixer": "^10.5.4",
    "basic-ftp": "^6.0.1",
    "esbuild": "^0.25.12",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2"
  }
}
