# === BUILDING INNOVATION US — ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!

# ----- Server -----
PORT=3000
NODE_ENV=production

# ----- Database -----
# SQLite (simplest, file-based)
DATABASE_URL=sqlite:./data/app.db
# OR PostgreSQL (preferred for production)
# DATABASE_URL=postgresql://user:***@host:5432/dbname

# ----- AI Provider -----
# Gemini (primary): get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI (fallback): get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter (unified backup): get your key at https://openrouter.ai/ (free tier available)
OPENROUTER_API_KEY=your_openrouter_key_here

# AI Provider priority: gemini | openai | openrouter
# Default: gemini (best image generation)
# Fallback chain: Gemini → OpenRouter → OpenAI → Generic
AI_PROVIDER=gemini

# ----- Stripe (payments) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Admin -----
ADMIN_EMAIL=admin@buildingapp.us
SITE_URL=https://buildingapp.us

# ----- Rate Limits -----
MAX_DAILY_GENERATIONS_FREE=10
MAX_DAILY_GENERATIONS_PRO=500
MAX_DAILY_GENERATIONS_PREMIUM=1000

# ----- Telegram Alerts (optional) -----
TELEGRAM_BOT_TOKEN=
