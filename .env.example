# SMTP Settings
SMTP_HOST=smtp.hostinger.com
SMTP_USER=admin@example.com
SMTP_PASS=your_email_password

# --- Payments ---
STRIPE_SECRET_KEY=your_stripe_secret_key

# --- Server ---
PORT=3000
NODE_ENV=development
