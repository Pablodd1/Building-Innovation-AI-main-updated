# === BUILDING INNOVATION US — ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!

# ----- Server -----
PORT=3000
NODE_ENV=production

# ----- Database -----
# SQLite (simplest, file-based)
DATABASE_URL=sqlite:./data/app.db
# OR PostgreSQL (preferred for production)
# DATABASE_URL=postgresql://user:***@host:5432/dbname

# ----- AI Provider -----
# Gemini (legacy, currently unused for image generation): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# OpenAI (active — analysis via gpt-4o, render via gpt-image-1.5): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OpenRouter (legacy, currently unused): https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here
# fal.ai — REQUIRED for high-fidelity inpaint rendering via FLUX.1 Fill.
# When set, inpaint mode prefers FLUX (composites unmasked pixels 1:1) over
# gpt-image-1.5 (which does a soft-mask full-image regeneration — furniture
# drift, pattern softening). ~$0.05/render. Without this key, inpaint falls
# back to OpenAI. Get a key at https://fal.ai/dashboard
FAL_API_KEY=

# AI Provider priority: gemini | openai | openrouter | flux
# (Currently OpenAI-only since July 2026 — Gemini/OpenRouter image paths
# were removed because they were calling the wrong API surfaces.)
AI_PROVIDER=openai

# ----- Stripe (payments) -----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Admin -----
ADMIN_EMAIL=admin@buildingapp.us
SITE_URL=https://buildingapp.us

# ----- Rate Limits -----
MAX_DAILY_GENERATIONS_FREE=10
MAX_DAILY_GENERATIONS_PRO=500
MAX_DAILY_GENERATIONS_PREMIUM=1000

# ----- Telegram Alerts (optional) -----
TELEGRAM_BOT_TOKEN=
