# === BUILDING INNOVATION US — ENVIRONMENT VARIABLES ===
# Copy this file to .env and fill in your values.
# The server also falls back to data/config.json for AI and Stripe keys.

# ----- Server -----
PORT=3000
NODE_ENV=production

# ----- Database -----
# Option 1: PostgreSQL connection string (preferred)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Option 2: Individual MySQL/PostgreSQL credentials
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=building_innovation

# ----- AI Provider -----
# Gemini (primary): get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI (fallback): get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ----- Stripe (payments) -----
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: override specific tier price IDs
# STRIPE_PRICE_STANDARD=price_xxx
# STRIPE_PRICE_PREMIUM=price_xxx
# STRIPE_PRICE_LUXURY=price_xxx

# ----- Admin -----
ADMIN_EMAIL=admin@buildingapp.us

# ----- Telegram Alerts (optional) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
